# ==============================================================================
# Supabase ERP to Turnkey Bridge Configuration
# ==============================================================================

# Supabase REST API Settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Company Information (MIG 4.1 Seller Information)
COMPANY_SELLER_BAN=00015555
COMPANY_SELLER_NAME=奧銳有限公司
COMPANY_SELLER_ADDR=臺北市中正區漢口街1段45號10樓
TURNKEY_ROUTING_ID=PA006753

# Turnkey Local Paths
TURNKEY_ROOT=/invoice/EINVTurnkey
XSD_ROOT=/invoice/EINVTurnkey/scripts/xsd_temp/xsd/v41

# Order Trigger Statuses (comma-separated internal_status values that trigger invoice issuance)
# Options from your ERP: pending, confirmed, packed, printed, shipped, delivered, completed
EINV_TRIGGER_INTERNAL_STATUSES=shipped,delivered,completed

# Default Bimonthly Period (ROC Year + 2-digit End Month, e.g. 11510 = 115/09~10)
CURRENT_YEAR_MONTH=11510

# Polling Interval in Seconds (Daemon mode)
POLL_INTERVAL_SECONDS=10
